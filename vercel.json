{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/auth",
      "destination": "/entrar",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "/recuperar-senha",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "/redefinir-senha",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/minha-area",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/minha-area",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/minha-area",
      "permanent": true
    },
    {
      "source": "/minha-frequencia",
      "destination": "/minha-area",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/cursos",
      "permanent": true
    },
    {
      "source": "/course/:id",
      "destination": "/formacao/curso/:id",
      "permanent": true
    },
    {
      "source": "/lesson/:id",
      "destination": "/minha-area",
      "permanent": false
    },
    {
      "source": "/esde/calendario/:codigo?",
      "destination": "/calendario/esde",
      "permanent": true
    },
    {
      "source": "/inscricao/p/:slug",
      "destination": "/inscricao/:slug",
      "permanent": true
    },
    {
      "source": "/inscricao/curso/:id",
      "destination": "/cursos/:id",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/formacao/gestao",
      "permanent": false
    }
  ]
}