{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/formacao/((?!assets/|.*\\.[a-z0-9]+$).*)",
      "destination": "/formacao/index.html"
    },
    {
      "source": "/((?!assets/|formacao/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/formacao/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cursos",
      "destination": "/formacao/",
      "permanent": false
    },
    {
      "source": "/cursos/:id",
      "destination": "/formacao/inscricao/curso/:id",
      "permanent": false
    },
    {
      "source": "/biblioteca",
      "destination": "/formacao/biblioteca",
      "permanent": false
    },
    {
      "source": "/calendario/:codigo?",
      "destination": "/formacao/esde/calendario",
      "permanent": false
    },
    {
      "source": "/inscricao/:slug",
      "destination": "/formacao/inscricao/p/:slug",
      "permanent": false
    },
    {
      "source": "/presenca/:token",
      "destination": "/formacao/presenca/:token",
      "permanent": false
    }
  ],
  "installCommand": "npm run install:apps"
}
